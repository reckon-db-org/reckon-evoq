{erl_opts, [
    debug_info,
    warn_export_vars,
    warn_unused_vars,
    warn_unused_import
]}.

{deps, [
    %% evoq for adapter behavior definitions.
    %% Floor 1.22: CCC payload-condition adapter callbacks
    %% (ccc_read_by_payload/4, ccc_read_by_payload_hash/4,
    %% payload_indexes/1, payload_hash_indexes/1).
    {evoq, "~> 1.22"},

    %% Gateway API for reckon-db operations.
    %% Provides shared types (event, snapshot, subscription records).
    %% Floor 3.7: get_payload_indexes/1 + get_payload_hash_indexes/1
    %% (introspection), on top of ccc_read_by_payload* from 3.6.
    {reckon_gater, "~> 3.7"},

    %% Telemetry for observability
    {telemetry, "~> 1.3"}
]}.

%% For local development, use _checkouts with symlinks:
%%   mkdir -p _checkouts
%%   ln -s /path/to/evoq _checkouts/evoq
%%   ln -s /path/to/reckon-gater _checkouts/reckon_gater
%%
%% WARNING — remove the symlinks BEFORE `rebar3 hex publish`. A
%% checkout dep is excluded from rebar.lock, and rebar3_hex derives
%% the published requirements from the lock: 2.4.0 shipped to hex
%% with NO reckon_gater requirement at all because the symlink was
%% present at publish time. Verify the requirements list in the
%% publish confirmation prompt includes evoq, reckon_gater, and
%% telemetry.

{profiles, [
    {test, [
        {deps, [
            {meck, "0.9.2"}
        ]}
    ]}
]}.

%% Xref checks, stated explicitly.
%%
%% Without this, rebar3's default set includes `exports_not_used', which for a
%% LIBRARY reports every part of its public API that this repository does not
%% itself call: 11 warnings here, all "unused export", and not one undefined
%% function. An adapter exists to be called from outside. Same list as
%% reckon-gater and reckon-db, so the family reads the same way.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

%% Pinned, and PROJECT plugins, not `plugins'. rebar3_hex and rebar3_ex_doc
%% used to sit under `plugins', unpinned: rebar3 installs a dependency's
%% `plugins' for everything that depends on it, so every consumer of
%% reckon_evoq fetched both, and an unpinned rebar3_hex resolves 7.3.0
%% (2026-09-22), which reads no environment variable for auth: CI's
%% HEX_API_KEY is ignored and publish dies on a bare badmatch. The pin lives
%% in this file, inside the tag, so no re-run can fix a bad one. Versions
%% match evoq 1.24.0. Bump one in its own commit, with the reason.
{project_plugins, [
    {rebar3_hex, "7.2.0"},
    {rebar3_ex_doc, "0.3.0"},
    {rebar3_lint, "6.0.0"}
]}.

%% Elvis style rules — shared macula_min ruleset (mirrors evoq). Targets the
%% structural smells (deep nesting, nested try/catch, if-expressions) rather
%% than the full erl_files ruleset. Run via `rebar3 lint`.
{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["src/**/*.erl"], ruleset => macula_min}
    ]}
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        underspecs
    ]},
    {plt_apps, top_level_deps}
]}.

%% Ex_doc configuration
{ex_doc, [
    {extras, [
        {"README.md", #{title => <<"Readme">>}},
        {"CHANGELOG.md", #{title => <<"Changelog">>}}
    ]},
    {main, <<"README.md">>},
    %% A map, source => target: ex_doc 0.40 refuses the bare-string form
    %% (ArgumentError), which failed every docs build, and with it hex build.
    {assets, #{<<"assets">> => <<"assets">>}},
    {source_url, <<"https://github.com/reckon-db-org/reckon-evoq">>}
]}.

%% Hex configuration
{hex, [
    {doc, #{provider => ex_doc}}
]}.

%% Package metadata for hex.pm
{pkg, [
    {name, reckon_evoq},
    {description, "Adapter for connecting evoq CQRS/ES framework to reckon-db event store via reckon-gater gateway."},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"GitHub", "https://github.com/reckon-db-org/reckon-evoq"},
        {"evoq", "https://github.com/reckon-db-org/evoq"},
        {"reckon-db", "https://github.com/reckon-db-org/reckon-db"},
        {"reckon-gater", "https://github.com/reckon-db-org/reckon-gater"}
    ]},
    {files, [
        "src",
        "assets",
        "rebar.config",
        "README.md",
        "CHANGELOG.md"
    ]},
    {maintainers, ["Reckon-DB"]},
    {build_tools, ["rebar3"]}
]}.
